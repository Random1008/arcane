{
  "name": "topdown-roguelite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n jeu,serveur -c cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "dev:game": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
